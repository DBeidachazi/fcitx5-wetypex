#!/usr/bin/env python3
"""Synchronize the Fcitx clipboard through the original WeType service."""
import fcntl
import base64
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time

data_home = pathlib.Path(os.environ.get("XDG_DATA_HOME", pathlib.Path.home() / ".local/share"))
state_dir = pathlib.Path(os.environ.get("WETYPE_STATE_DIR", data_home / "fcitx5-wetypex/state"))
account_tool = os.environ.get("WETYPE_ACCOUNT_TOOL", "@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-account")
clipboard_helper = os.environ.get("WETYPE_CLIPBOARD_HELPER", "@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-clipboard-set")
state_dir.mkdir(parents=True, exist_ok=True)
state_dir.chmod(0o700)
lock = open(state_dir / "syncd.lock", "a+")
(state_dir / "syncd.lock").chmod(0o600)
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)

def atomic_json(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)

def call(*arguments):
    try:
        result = subprocess.run([account_tool, *arguments], capture_output=True,
                                text=True, timeout=35)
    except subprocess.TimeoutExpired:
        return {"ok": False}
    if not result.stdout:
        return {"ok": False}
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return {"ok": False}

runtime_path = state_dir / "sync-runtime.json"
try:
    runtime = json.loads(runtime_path.read_text())
except (OSError, json.JSONDecodeError):
    runtime = {}
last_remote_version = int(runtime.get("remote_version", 0))
last_outbox_id = str(runtime.get("outbox_id", ""))
last_image_digest = str(runtime.get("image_digest", ""))
last_text_digest = str(runtime.get("text_digest", ""))
once = "--once" in sys.argv
clipboard_owner = None
wl_copy = shutil.which("wl-copy") if os.environ.get("WAYLAND_DISPLAY") else None
wl_paste = shutil.which("wl-paste") if os.environ.get("WAYLAND_DISPLAY") else None

while True:
    group = call("group-info")
    if group.get("ok"):
        atomic_json(state_dir / "sync-state.json", group)
        group_id = int(group.get("group_id", 0))
        functions = int(group.get("func_switch", 0))
        if group_id and functions & 1:
            helper_environment = os.environ.copy()
            helper_environment["QT_IM_MODULE"] = "none"
            version = int(group.get("clipboard_version", 0))
            remote = str(group.get("clipboard", ""))
            remote_type = int(group.get("clipboard_type", 0))
            remote_binary = str(group.get("clipboard_binary", ""))
            received_remote = False
            if (version > last_remote_version and remote_type in (5, 6, 100) and
                    remote_binary):
                try:
                    image = base64.b64decode(remote_binary, validate=True)
                except (ValueError, base64.binascii.Error):
                    image = b""
                if 0 < len(image) <= 8388608:
                    normalized = subprocess.run(
                        [clipboard_helper, "--normalize-image"], input=image,
                        capture_output=True, timeout=4,
                        env=helper_environment)
                    if normalized.returncode != 0 or not normalized.stdout:
                        image = b""
                    else:
                        image = normalized.stdout
                if image:
                    if wl_copy:
                        subprocess.run([wl_copy, "--type", "image/png"],
                                       input=image, timeout=4,
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL,
                                       env=helper_environment)
                    else:
                        if clipboard_owner and clipboard_owner.poll() is None:
                            clipboard_owner.terminate()
                        clipboard_owner = subprocess.Popen(
                            [clipboard_helper, "--image"], stdin=subprocess.PIPE,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            env=helper_environment)
                        clipboard_owner.stdin.write(image)
                        clipboard_owner.stdin.close()
                    last_image_digest = hashlib.sha256(image).hexdigest()
                    last_remote_version = version
                    received_remote = True
            elif version > last_remote_version and remote:
                atomic_json(state_dir / "clipboard-inbox.json",
                            {"version": version, "text": remote})
                if clipboard_owner and clipboard_owner.poll() is None:
                    clipboard_owner.terminate()
                clipboard_owner = subprocess.Popen(
                    [clipboard_helper], stdin=subprocess.PIPE,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    env=helper_environment)
                clipboard_owner.stdin.write(remote.encode())
                clipboard_owner.stdin.close()
                last_text_digest = hashlib.sha256(remote.encode()).hexdigest()
                last_remote_version = version
                received_remote = True

            outbox_path = state_dir / "clipboard-outbox.json"
            try:
                outbox = json.loads(outbox_path.read_text())
            except (OSError, json.JSONDecodeError):
                outbox = {}
            outbox_id = str(outbox.get("id", ""))
            text = str(outbox.get("text", ""))
            if received_remote and outbox_id:
                last_outbox_id = outbox_id
            elif outbox_id and outbox_id != last_outbox_id and text:
                sent = call("send-clipboard", str(group_id), text)
                if sent.get("ok"):
                    last_outbox_id = outbox_id
                    last_text_digest = hashlib.sha256(text.encode()).hexdigest()
            if not received_remote:
                try:
                    local_text = subprocess.run(
                        ([wl_paste, "--no-newline"]
                         if wl_paste else [clipboard_helper, "--read-text"]),
                        capture_output=True, timeout=4, env=helper_environment)
                except subprocess.TimeoutExpired:
                    local_text = None
                if (local_text and local_text.returncode == 0 and
                        0 < len(local_text.stdout) <= 16384):
                    try:
                        clipboard_text = local_text.stdout.decode("utf-8")
                    except UnicodeDecodeError:
                        clipboard_text = ""
                    digest = hashlib.sha256(local_text.stdout).hexdigest()
                    if not last_text_digest:
                        # Enabling sync does not upload unrelated clipboard data
                        # that predates the setting. Changes after this baseline do.
                        last_text_digest = digest
                    elif clipboard_text and digest != last_text_digest:
                        sent = call("send-clipboard", str(group_id), clipboard_text)
                        if sent.get("ok"):
                            last_text_digest = digest
                try:
                    local_image = subprocess.run(
                        ([wl_paste, "--no-newline", "--type", "image/png"]
                         if wl_paste else [clipboard_helper, "--read-image"]),
                        capture_output=True, timeout=4, env=helper_environment)
                except subprocess.TimeoutExpired:
                    local_image = None
                if (local_image and local_image.returncode == 0 and
                        0 < len(local_image.stdout) <= 8388608):
                    digest = hashlib.sha256(local_image.stdout).hexdigest()
                    if digest != last_image_digest:
                        image_path = state_dir / "clipboard-outbox.png"
                        temporary = image_path.with_suffix(".png.tmp")
                        temporary.write_bytes(local_image.stdout)
                        temporary.chmod(0o600)
                        temporary.replace(image_path)
                        sent = call("send-image", str(group_id), str(image_path))
                        if sent.get("ok"):
                            last_image_digest = digest
            atomic_json(runtime_path, {"remote_version": last_remote_version,
                                       "outbox_id": last_outbox_id,
                                       "image_digest": last_image_digest,
                                       "text_digest": last_text_digest})
    if once:
        break
    time.sleep(3 if group.get("ok") else 10)
